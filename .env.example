# Copy to .env.local for local development. On the live site these are set in
# Cloudflare Pages under Settings -> Environment variables, NOT in this repo.
#
# Anything prefixed VITE_ is compiled into the public JavaScript bundle. Treat
# these as public values. Never put a secret here.

# Google Calendar API key, restricted by HTTP referrer to embsucf.org.
# Create at console.cloud.google.com -> APIs & Services -> Credentials.
VITE_GOOGLE_API_KEY=

# Optional. Overrides the calendar ID set in the admin panel under Settings.
# Normally leave this blank and manage the calendar from /admin instead.
VITE_GOOGLE_CALENDAR_ID=

# Force fixture calendar data even when a key is set. Development only —
# this has no effect in a production build. See docs/DEVELOPMENT.md.
VITE_CALENDAR_MOCK=
