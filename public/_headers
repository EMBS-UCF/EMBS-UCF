/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Vite fingerprints these filenames, so they can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Root images are not content-hashed, so they cannot be immutable — but they
# change about once a year, and a day of staleness after a logo swap is fine.
/*.png
  Cache-Control: public, max-age=86400

# HTML is rewritten on every deploy and must not be held in a cache.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
